# =============================================================================
# MODUS: Wähle wie LLM-Zugriff erfolgt
# hub    → Alle Modelle über den adesso AI Hub (ein zentraler Token)
# direct → Jeder Anbieter bekommt seinen eigenen API-Key
# =============================================================================
LLM_PROVIDER=hub

# =============================================================================
# AI HUB (nur relevant wenn LLM_PROVIDER=hub)
# =============================================================================
AI_HUB_URL=https://adesso-ai-hub.3asabc.de/v1
AI_HUB_TOKEN=your_ai_hub_token_here

# =============================================================================
# DIREKTE ANBIETER (nur relevant wenn LLM_PROVIDER=direct)
# =============================================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# DISCORD – DM Agent
# =============================================================================
DISCORD_TOKEN=your_dm_agent_token_here

# =============================================================================
# DISCORD – Spieler Agents (je eine Discord App pro Charakter)
# =============================================================================
DISCORD_TOKEN_CLAUDERIC=your_clauderic_token_here
DISCORD_TOKEN_GEMINIRA=your_geminira_token_here
DISCORD_TOKEN_GROKMAR=your_grokmar_token_here
DISCORD_TOKEN_LLAMARA=your_llamara_token_here
DISCORD_TOKEN_MISTRALYN=your_mistralyn_token_here
DISCORD_TOKEN_QWENDOR=your_qwendor_token_here

# =============================================================================
# KAMPAGNE
# =============================================================================
CAMPAIGN=stadt-der-tausend-luegen
