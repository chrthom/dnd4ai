# =============================================================================
# MODUS: Wähle wie LLM-Zugriff erfolgt
# hub    → Alle Modelle über den adesso AI Hub (ein zentraler Token)
# direct → Jeder Anbieter bekommt seinen eigenen API-Key
# =============================================================================
LLM_PROVIDER=hub

# =============================================================================
# AI HUB (nur relevant wenn LLM_PROVIDER=hub)
# =============================================================================
AI_HUB_URL=https://adesso-ai-hub.3asabc.de/v1
AI_HUB_TOKEN=your_ai_hub_token_here

# =============================================================================
# DIREKTE ANBIETER (nur relevant wenn LLM_PROVIDER=direct)
# =============================================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# DISCORD – DM Agent (Haupt-Bot-Token)
# =============================================================================
DISCORD_TOKEN=your_dm_agent_token_here

# =============================================================================
# DISCORD – Spieler Agents (je eine Discord App pro Charakter)
# =============================================================================
DISCORD_TOKEN_CLAUDERIC=your_clauderic_token_here
DISCORD_TOKEN_GEMINIRA=your_geminira_token_here
DISCORD_TOKEN_GROKMAR=your_grokmar_token_here
DISCORD_TOKEN_LLAMARA=your_llamara_token_here
DISCORD_TOKEN_MISTRALYN=your_mistralyn_token_here
DISCORD_TOKEN_QWENDOR=your_qwendor_token_here

# =============================================================================
# MODELLE – DM Agent
# LLM_PROVIDER_DM überschreibt LLM_PROVIDER nur für den DM
# =============================================================================
LLM_MODEL_DM=gpt-4o
#LLM_PROVIDER_DM=hub

# =============================================================================
# MODELLE – Spieler Charaktere (Modellname wie vom Anbieter / Hub erwartet)
# LLM_PROVIDER_<CHARAKTER> überschreibt LLM_PROVIDER für einzelne Bots
# =============================================================================
LLM_MODEL_CLAUDERIC=claude-sonnet-4-6
LLM_MODEL_GEMINIRA=gemini-2.0-flash
LLM_MODEL_GROKMAR=gpt-4o
LLM_MODEL_LLAMARA=llama-3.3-70b-versatile
LLM_MODEL_MISTRALYN=mistral-large-latest
LLM_MODEL_QWENDOR=qwen-2.5-72b-instruct

#LLM_PROVIDER_GROKMAR=hub
#LLM_PROVIDER_QWENDOR=hub

# =============================================================================
# PROVIDER PRO CHARAKTER (optional – überschreibt LLM_PROVIDER für diesen Bot)
# Werte: hub | direct
# Weglassen = globaler LLM_PROVIDER wird verwendet
# =============================================================================
#LLM_PROVIDER_CLAUDERIC=direct
#LLM_PROVIDER_GEMINIRA=hub
#LLM_PROVIDER_GROKMAR=direct
#LLM_PROVIDER_LLAMARA=direct
#LLM_PROVIDER_MISTRALYN=direct
#LLM_PROVIDER_QWENDOR=hub

# =============================================================================
# KAMPAGNE
# =============================================================================
CAMPAIGN=stadt-der-tausend-luegen

# =============================================================================
# TIMING (optional)
# =============================================================================
# Sekunden zwischen Polls (Standard: 5)
#POLL_INTERVAL=5
# Sekunden warten bevor DM antwortet – sammelt alle Spieler-Antworten (Standard: 8)
#DM_RESPONSE_DELAY=8

# =============================================================================
# BILDGENERIERUNG (für summary_agent.py)
# =============================================================================
# Komma-separierte Liste, in Reihenfolge versucht:
#   pollinations → komplett kostenlos, kein API-Key nötig
#   hub          → adesso AI Hub (Budget muss reichen)
#   openai       → DALL-E 3 direkt (kostet pro Bild)
IMAGE_PROVIDER=pollinations,hub,openai
IMAGE_MODEL=dall-e-3

# =============================================================================
# TEXTZUSAMMENFASSUNG (für summary_agent.py)
# Optional: überschreibt das Geminira-Modell für die Akt-Texte
# Standard: nutzt LLM_MODEL_GEMINIRA + LLM_PROVIDER_GEMINIRA
# =============================================================================
#SUMMARY_MODEL=gemini-2.0-flash
#SUMMARY_PROVIDER=direct
